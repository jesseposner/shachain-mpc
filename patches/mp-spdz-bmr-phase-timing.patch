+namespace bmr_package
+{
+inline void put(ostream& os, const void* data, size_t size)
+{
+	os.write((const char*) &size, sizeof(size));
+	os.write((const char*) data, size);
+}
+
+inline size_t get(istream& is, vector<char>& data)
+{
+	size_t size = 0;
+	is.read((char*) &size, sizeof(size));
+	data.resize(size);
+	is.read(data.data(), size);
+	if (!is)
+		throw runtime_error("truncated BMR package");
+	return size;
+}
+}
+
+template<class T>
+void RealProgramParty<T>::dump_package(const string& path)
+{
+	ofstream os(path, ios::binary);
+	if (!os)
+		throw runtime_error("cannot write BMR package: " + path);
+	os.write((const char*) &this->delta, sizeof(this->delta));
+	for (auto* store : {&this->garbled_circuits, &this->input_masks_store,
+			&this->output_masks_store, &this->wire_storage})
+	{
+		vector<vector<char>> blobs;
+		ReceivedMsg msg;
+		while (store->pop(msg))
+			blobs.emplace_back(msg.data(), msg.data() + msg.size());
+		size_t n = blobs.size();
+		os.write((const char*) &n, sizeof(n));
+		for (auto& m : blobs)
+			bmr_package::put(os, m.data(), m.size());
+	}
+	for (int op = 0; op < SPDZ_OP_N; op++)
+	{
+		size_t n = this->spdz_wires[op].size();
+		os.write((const char*) &n, sizeof(n));
+		for (auto& stream : this->spdz_wires[op])
+			bmr_package::put(os, stream.get_data(), stream.get_length());
+	}
+	if (!os)
+		throw runtime_error("failed writing BMR package: " + path);
+}
+
+template<class T>
+void RealProgramParty<T>::load_package(const string& path)
+{
+	ifstream is(path, ios::binary);
+	if (!is)
+		throw runtime_error("cannot read BMR package: " + path);
+	is.read((char*) &this->delta, sizeof(this->delta));
+	vector<char> data;
+	for (auto* store : {&this->garbled_circuits, &this->input_masks_store,
+			&this->output_masks_store, &this->wire_storage})
+	{
+		size_t n = 0;
+		is.read((char*) &n, sizeof(n));
+		for (size_t i = 0; i < n; i++)
+		{
+			bmr_package::get(is, data);
+			LocalBuffer msg;
+			msg.serialize(data.data(), data.size());
+			msg.reset_head();
+			store->push_and_clear(msg);
+		}
+	}
+	for (int op = 0; op < SPDZ_OP_N; op++)
+	{
+		this->spdz_wires[op].clear();
+		size_t n = 0;
+		is.read((char*) &n, sizeof(n));
+		for (size_t i = 0; i < n; i++)
+		{
+			bmr_package::get(is, data);
+			this->spdz_wires[op].push_back({});
+			this->spdz_wires[op].back().append(
+					(const octet*) data.data(), data.size());
+		}
+	}
+}
