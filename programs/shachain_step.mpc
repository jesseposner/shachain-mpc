# Threshold BOLT #3 shachain edge in MPC.
#
# Computes K sequential shachain edges on a secret-shared 32-byte value,
#     x <- SHA256(flip_b(x)),
# exactly as BOLT #3 generate_from_seed does, then (optionally) checks that the
# result is a valid secp256k1 scalar (1 <= s < q) and converts the 256-bit
# string into an arithmetic sharing over Z_q. The input stays a secret-shared
# bit string throughout; nothing is ever reduced modulo q before hashing.
#
# Arguments (positional, after the program name):
#   K      sequential edges to walk (latency)            default 1
#   N      independent chains evaluated in parallel       default 1
#   B2A    1 = include Boolean-to-arithmetic conversion    default 1
#   CHECK  1 = reveal results for correctness checking     default 0
#   SEP    1 = feed the N chains as separate inputs rather  default 0
#              than one vectorised input (needed for BMR, which
#              lacks vectorised input instructions)
#
# Conventions:
#   The bit vector x.v uses v[k] = bit (7 - k % 8) of byte k // 8 (MSB first
#   within each byte), matching sbitvec.from_hex(..., reverse=False).
#   BOLT's flip(B) toggles bit (B % 8) of byte (B / 8), bit j having value 1<<j,
#   so it lands at vector index (B // 8) * 8 + (7 - B % 8).
#   circuit.sha256() returns LSB-first (v[0] = LSB of the big-endian integer).
from circuit import sha256
from Compiler.GC.types import sbitvec, sbit, sbits

K = int(program.args[1]) if len(program.args) > 1 else 1
N = int(program.args[2]) if len(program.args) > 2 else 1
B2A = int(program.args[3]) if len(program.args) > 3 else 1
CHECK = int(program.args[4]) if len(program.args) > 4 else 0
SEP = int(program.args[5]) if len(program.args) > 5 else 0
IDX = int(program.args[6]) if len(program.args) > 6 else 0
EXPORT = int(program.args[7]) if len(program.args) > 7 else 0

SECP256K1_ORDER = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141

# Which bits to flip, high to low. The default walks a path of right edges
# from the root, as in the 48-hash cold start; which bit is flipped does not
# affect cost, since the flip is a free public negation. With IDX >= 0 this
# is exactly BOLT #3 generate_from_seed(seed, IDX).
if IDX > 0:
    BITS = [b for b in range(47, -1, -1) if (IDX >> b) & 1]
else:
    BITS = [47 - i for i in range(K)]


def bolt_flip_index(b):
    return (b // 8) * 8 + (7 - b % 8)


def lsb_first(x):
    """Byte-MSB-first vector -> LSB-first bit list of the big-endian integer."""
    return list(reversed(x.v))


def less_than_const(bits_lsb, c):
    """Secret [x] < public c, for x given LSB first. One AND per bit."""
    lt = None  # "x < c" restricted to bits processed so far; None = false
    for i, xi in enumerate(bits_lsb):
        if (c >> i) & 1:
            lt = ~xi if lt is None else ~(xi & ~lt)   # ~x_i | lt
        else:
            lt = None if lt is None else ~xi & lt
    return lt


def nonzero(bits):
    """OR of all bits as a balanced tree."""
    while len(bits) > 1:
        nxt = [~(~a & ~b) for a, b in zip(bits[0::2], bits[1::2])]
        if len(bits) % 2:
            nxt.append(bits[-1])
        bits = nxt
    return bits[0]


t256 = sbitvec.get_type(256)
if SEP:
    xs = [t256.get_input_from(0) for _ in range(N)]
else:
    xs = [t256.get_input_from(0, size=N) if N > 1 else t256.get_input_from(0)]


def walk(x):
    for b in BITS:
        v = list(x.v)
        k = bolt_flip_index(b)
        v[k] = ~v[k]
        h = sha256(sbitvec.from_vec(v))
        x = sbitvec.from_vec(list(reversed(h.v)))
    return x


start_timer(1)
xs = [walk(x) for x in xs]
stop_timer(1)

s_bits = lsb_first(xs[0])

start_timer(2)
valids = [less_than_const(lsb_first(x), SECP256K1_ORDER) & nonzero(lsb_first(x))
          for x in xs]
valid = valids[0]
stop_timer(2)

if B2A:
    start_timer(3)
    ss = [sint.bit_compose(lsb_first(x)) for x in xs]
    s = ss[0]
    stop_timer(3)
    if EXPORT:
        # Known calibration value first, then the secret share.
        sint.write_to_file([sint(1), s], position=0)

if CHECK:
    sbitvec.from_vec(s_bits).reveal().print_reg()
    print_ln('valid %s', valid.reveal())
    if B2A:
        print_ln('scalar %s', s.reveal())
