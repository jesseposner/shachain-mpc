# Threshold BOLT #3 shachain edge in MPC.
#
# Computes K sequential shachain edges on a secret-shared 32-byte value,
#     x <- SHA256(flip_b(x)),
# exactly as BOLT #3 generate_from_seed does, then (optionally) checks that the
# result is a valid secp256k1 scalar (1 <= s < q) and converts the 256-bit
# string into an arithmetic sharing over Z_q. The input stays a secret-shared
# bit string throughout; nothing is ever reduced modulo q before hashing.
#
# Arguments (positional, after the program name):
#   K      sequential edges to walk (latency)            default 1
#   N      independent chains evaluated in parallel       default 1
#   B2A    1 = include Boolean-to-arithmetic conversion    default 1
#   CHECK  1 = reveal results for correctness checking     default 0
#   SEP    1 = feed the N chains as separate inputs rather  default 0
#              than one vectorised input (needed for BMR, which
#              lacks vectorised input instructions)
#
# Conventions:
#   The bit vector x.v uses v[k] = bit (7 - k % 8) of byte k // 8 (MSB first
#   within each byte), matching sbitvec.from_hex(..., reverse=False).
#   BOLT's flip(B) toggles bit (B % 8) of byte (B / 8), bit j having value 1<<j,
#   so it lands at vector index (B // 8) * 8 + (7 - B % 8).
#   circuit.sha256() returns LSB-first (v[0] = LSB of the big-endian integer).
from circuit import sha256, Circuit
from Compiler.GC.types import sbitvec, sbit, sbits

K = int(program.args[1]) if len(program.args) > 1 else 1
N = int(program.args[2]) if len(program.args) > 2 else 1
B2A = int(program.args[3]) if len(program.args) > 3 else 1
CHECK = int(program.args[4]) if len(program.args) > 4 else 0
SEP = int(program.args[5]) if len(program.args) > 5 else 0
IDX = int(program.args[6]) if len(program.args) > 6 else 0
EXPORT = int(program.args[7]) if len(program.args) > 7 else 0
CONTRIB = int(program.args[8]) if len(program.args) > 8 else 1

SECP256K1_ORDER = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141

# Which bits to flip, high to low. The default walks a path of right edges
# from the root, as in the 48-hash cold start; which bit is flipped does not
# affect cost, since the flip is a free public negation. With IDX >= 0 this
# is exactly BOLT #3 generate_from_seed(seed, IDX).
if IDX > 0:
    BITS = [b for b in range(47, -1, -1) if (IDX >> b) & 1]
else:
    BITS = [47 - i for i in range(K)]


# circuit.sha256 builds its padding and initial state with sbit(), which is
# one bit wide. With a vectorised input that gives lane 0 the constants and
# every other lane zeros, so only lane 0 comes out correct. Verified: two
# lanes in, lane 0 matched SHA-256 and lane 1 did not. This version
# broadcasts each constant across all lanes.
_SHA_CIRCUIT = Circuit('sha256')
_SHA_IV = [0x6a, 0x09, 0xe6, 0x67, 0xbb, 0x67, 0xae, 0x85,
           0x3c, 0x6e, 0xf3, 0x72, 0xa5, 0x4f, 0xf5, 0x3a,
           0x51, 0x0e, 0x52, 0x7f, 0x9b, 0x05, 0x68, 0x8c,
           0x1f, 0x83, 0xd9, 0xab, 0x5b, 0xe0, 0xcd, 0x19]


def sha256_lanes(x, lanes):
    """SHA-256 over an sbitvec of `lanes` lanes, correct in every lane."""
    if lanes == 1:
        return sha256(x)
    t = sbits.get_type(lanes)
    ones = (1 << lanes) - 1

    def const(b):
        return t(ones if b else 0)

    L = len(x.v)
    padding = [1]
    while (len(padding) + L) % 512 != (512 - 64):
        padding.append(0)
    padding += [(L >> (63 - i)) & 1 for i in range(64)]
    padded = x.v + [const(b) for b in padding]
    state = list(reversed([const((_SHA_IV[i // 8] >> (7 - i % 8)) & 1)
                           for i in range(256)]))
    for i in range(0, len(padded), 512):
        chunk = list(reversed(padded[i:i + 512]))
        state = _SHA_CIRCUIT(chunk + state).v
    return sbitvec.from_vec(state)


def bolt_flip_index(b):
    return (b // 8) * 8 + (7 - b % 8)


def lsb_first(x):
    """Byte-MSB-first vector -> LSB-first bit list of the big-endian integer."""
    return list(reversed(x.v))


def less_than_const(bits_lsb, c):
    """Secret [x] < public c, for x given LSB first.

    Written as a balanced tree rather than a carry chain: the serial form
    costs 256 sequential communication rounds, which is invisible on one
    machine (8 ms) and expensive over a network (10.2 s measured across
    three continents). Depth here is log2(256) = 8 rounds.

    For each bit position, with c public, define
        lt_i = [x_i < c_i]   eq_i = [x_i == c_i]
    which are free: c_i = 1 gives (~x_i, x_i), c_i = 0 gives (0, ~x_i).
    Then x < c is the fold, from the most significant bit down, of the
    associative operator
        (lt_hi, eq_hi) . (lt_lo, eq_lo) = (lt_hi | (eq_hi & lt_lo),
                                           eq_hi & eq_lo)
    so it can be evaluated as a tree instead of a chain.
    """
    # most significant bit first
    terms = []
    for i in range(len(bits_lsb) - 1, -1, -1):
        xi = bits_lsb[i]
        if (c >> i) & 1:
            terms.append((~xi, xi))        # lt_i = ~x_i, eq_i = x_i
        else:
            terms.append((None, ~xi))      # lt_i = 0,    eq_i = ~x_i

    def combine(hi, lo):
        lt_hi, eq_hi = hi
        lt_lo, eq_lo = lo
        if lt_lo is None:
            lt = lt_hi
        else:
            both = eq_hi & lt_lo
            lt = both if lt_hi is None else ~(~lt_hi & ~both)   # lt_hi | both
        return (lt, eq_hi & eq_lo)

    while len(terms) > 1:
        nxt = [combine(terms[i], terms[i + 1])
               for i in range(0, len(terms) - 1, 2)]
        if len(terms) % 2:
            nxt.append(terms[-1])
        terms = nxt
    return terms[0][0]


def nonzero(bits):
    """OR of all bits as a balanced tree."""
    while len(bits) > 1:
        nxt = [~(~a & ~b) for a, b in zip(bits[0::2], bits[1::2])]
        if len(bits) % 2:
            nxt.append(bits[-1])
        bits = nxt
    return bits[0]


t256 = sbitvec.get_type(256)


def gather(size=1):
    """XOR of CONTRIB parties' contributions; no single party knows the result
    when CONTRIB > 1. The XOR gates are free."""
    def one(player):
        return (t256.get_input_from(player, size=size) if size > 1
                else t256.get_input_from(player))
    acc = one(0)
    for player in range(1, CONTRIB):
        other = one(player)
        acc = sbitvec.from_vec([a ^ b for a, b in zip(acc.v, other.v)])
    return acc


if SEP:
    xs = [gather() for _ in range(N)]
else:
    xs = [gather(size=N)]


def walk(x):
    for b in BITS:
        v = list(x.v)
        k = bolt_flip_index(b)
        v[k] = ~v[k]
        h = sha256_lanes(sbitvec.from_vec(v), 1 if SEP else N)
        x = sbitvec.from_vec(list(reversed(h.v)))
    return x


start_timer(1)
xs = [walk(x) for x in xs]
stop_timer(1)

s_bits = lsb_first(xs[0])

start_timer(2)
valids = [less_than_const(lsb_first(x), SECP256K1_ORDER) & nonzero(lsb_first(x))
          for x in xs]
valid = valids[0]
stop_timer(2)

if B2A:
    start_timer(3)
    ss = [sint.bit_compose(lsb_first(x)) for x in xs]
    s = ss[0]
    stop_timer(3)
    if EXPORT:
        # Known calibration value first, then the secret share.
        sint.write_to_file([sint(1), s], position=0)

if CHECK:
    # Reveal every lane, not only the first. An earlier version revealed
    # lane 0 alone, which hid that vectorised hashing was wrong in every
    # other lane.
    for x in xs:
        r = sbitvec.from_vec(lsb_first(x)).reveal()
        for lane in (r if isinstance(r, list) else [r]):
            lane.print_reg()
    print_ln('valid %s', valid.reveal())
    if B2A:
        print_ln('scalar %s', s.reveal())
