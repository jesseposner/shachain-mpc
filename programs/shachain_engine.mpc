# Generic shachain engine step, driven by a JSON plan file.
#
# The driver (poc/driver.py) does all public bookkeeping: which frontier
# nodes exist, which edges the next leaf needs, what leaves the run should
# reveal or export. This program executes one step:
#
#   1. Reconstruct secret values named in the plan, either from RSS seed
#      summands (XOR of per-slot inputs) or from masked frontier tuples
#      (public masked value XOR each active party's mask input).
#   2. Apply the planned flip-and-hash edges (BOLT #3 H_b).
#   3. Emit outputs: "mask" re-shares a value under fresh party masks and
#      reveals only the masked form; "open" reveals a leaf secret in the
#      clear (revocation); "export" converts a leaf to Z_q shares, checks
#      1 <= s < q, writes each party's share to persistence for point
#      export, and reveals the validity bit.
#
# The plan file path comes from the ENGINE_PLAN environment variable at
# compile time; a nonce argument keeps compiled program names distinct.
#
# Input order per party (the driver must write input files in this order):
#   1. its seed summands, in plan order (parties named by slot);
#   2. one mask per "masked" entry, in plan order (every party);
#   3. one fresh mask per "mask" output, in plan order (every party).
import json
import os

from circuit import sha256, Circuit
from Compiler.GC.types import sbitvec, sbit, sbits

NONCE = program.args[1] if len(program.args) > 1 else '0'
N_PARTIES = 3
SECP256K1_ORDER = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141

plan = json.load(open(os.environ['ENGINE_PLAN']))
t256 = sbitvec.get_type(256)
values = {}


# circuit.sha256 builds its padding and initial state with sbit(), which is
# one bit wide. With a vectorised input that gives lane 0 the constants and
# every other lane zeros, so only lane 0 comes out correct. Verified: two
# lanes in, lane 0 matched SHA-256 and lane 1 did not. This version
# broadcasts each constant across all lanes.
_SHA_CIRCUIT = Circuit('sha256')
_SHA_IV = [0x6a, 0x09, 0xe6, 0x67, 0xbb, 0x67, 0xae, 0x85,
           0x3c, 0x6e, 0xf3, 0x72, 0xa5, 0x4f, 0xf5, 0x3a,
           0x51, 0x0e, 0x52, 0x7f, 0x9b, 0x05, 0x68, 0x8c,
           0x1f, 0x83, 0xd9, 0xab, 0x5b, 0xe0, 0xcd, 0x19]


def sha256_lanes(x, lanes):
    """SHA-256 over an sbitvec of `lanes` lanes, correct in every lane."""
    if lanes == 1:
        return sha256(x)
    t = sbits.get_type(lanes)
    ones = (1 << lanes) - 1

    def const(b):
        return t(ones if b else 0)

    L = len(x.v)
    padding = [1]
    while (len(padding) + L) % 512 != (512 - 64):
        padding.append(0)
    padding += [(L >> (63 - i)) & 1 for i in range(64)]
    padded = x.v + [const(b) for b in padding]
    state = list(reversed([const((_SHA_IV[i // 8] >> (7 - i % 8)) & 1)
                           for i in range(256)]))
    for i in range(0, len(padded), 512):
        chunk = list(reversed(padded[i:i + 512]))
        state = _SHA_CIRCUIT(chunk + state).v
    return sbitvec.from_vec(state)


def bolt_flip_index(b):
    return (b // 8) * 8 + (7 - b % 8)


def xor_vec(a, b):
    return sbitvec.from_vec([x ^ y for x, y in zip(a.v, b.v)])


def lsb_first(x):
    return list(reversed(x.v))


def less_than_const(bits_lsb, c):
    """Secret [x] < public c, for x given LSB first.

    Written as a balanced tree rather than a carry chain: the serial form
    costs 256 sequential communication rounds, which is invisible on one
    machine (8 ms) and expensive over a network (10.2 s measured across
    three continents). Depth here is log2(256) = 8 rounds.

    For each bit position, with c public, define
        lt_i = [x_i < c_i]   eq_i = [x_i == c_i]
    which are free: c_i = 1 gives (~x_i, x_i), c_i = 0 gives (0, ~x_i).
    Then x < c is the fold, from the most significant bit down, of the
    associative operator
        (lt_hi, eq_hi) . (lt_lo, eq_lo) = (lt_hi | (eq_hi & lt_lo),
                                           eq_hi & eq_lo)
    so it can be evaluated as a tree instead of a chain.
    """
    # most significant bit first
    terms = []
    for i in range(len(bits_lsb) - 1, -1, -1):
        xi = bits_lsb[i]
        if (c >> i) & 1:
            terms.append((~xi, xi))        # lt_i = ~x_i, eq_i = x_i
        else:
            terms.append((None, ~xi))      # lt_i = 0,    eq_i = ~x_i

    def combine(hi, lo):
        lt_hi, eq_hi = hi
        lt_lo, eq_lo = lo
        if lt_lo is None:
            lt = lt_hi
        else:
            both = eq_hi & lt_lo
            lt = both if lt_hi is None else ~(~lt_hi & ~both)   # lt_hi | both
        return (lt, eq_hi & eq_lo)

    while len(terms) > 1:
        nxt = [combine(terms[i], terms[i + 1])
               for i in range(0, len(terms) - 1, 2)]
        if len(terms) % 2:
            nxt.append(terms[-1])
        terms = nxt
    return terms[0][0]


def nonzero(bits):
    while len(bits) > 1:
        nxt = [~(~a & ~b) for a, b in zip(bits[0::2], bits[1::2])]
        if len(bits) % 2:
            nxt.append(bits[-1])
        bits = nxt
    return bits[0]


# 1. Reconstruct inputs.
for item in plan.get('summands', []):
    # {"id": ..., "slots": [players contributing one summand each]}
    acc = None
    for slot in item['slots']:
        contrib = t256.get_input_from(slot)
        acc = contrib if acc is None else xor_vec(acc, contrib)
    values[item['id']] = acc

for item in plan.get('masked', []):
    # {"id": ..., "m": hex of public masked value}
    acc = t256(int(item['m'], 16))
    for player in range(N_PARTIES):
        acc = xor_vec(acc, t256.get_input_from(player))
    values[item['id']] = acc

# 2. Hash edges, grouped so that independent hashes cost one round-trip
# rather than one each.
#
# Latency is charged per communication round, and a round carries as many
# independent hashes as you care to put in it: 64 lanes cost 1,775 rounds
# against 1,621 for a single lane. Issuing one call per edge, as this used
# to, makes a plan cost its edge count in waits instead of its depth. That
# is the difference between preparing 1,024 secrets in ten waits and in
# 1,024 of them.
#
# An edge sits at one more level than its source, and every edge in a
# tree expansion at the same level flips the same bit, so grouping by
# (level, flip bit) yields batches that need no per-lane flip handling.
ops = plan.get('ops', [])
level = {vid: 0 for vid in values}
for op in ops:                       # plans are emitted in dependency order
    level[op['dst']] = level.get(op['src'], 0) + 1

groups = {}
for op in ops:
    groups.setdefault((level[op['dst']], op['bit']), []).append(op)


def combine(vals, n):
    """N single-lane values -> one n-lane sbitvec."""
    tn = sbits.get_type(n)
    return [tn.bit_compose([vals[j].v[i] for j in range(n)])
            for i in range(256)]


start_timer(1)
for key in sorted(groups):           # level order keeps dependencies satisfied
    batch = groups[key]
    k = bolt_flip_index(key[1])
    n = len(batch)
    if n == 1:
        v = list(values[batch[0]['src']].v)
        v[k] = ~v[k]
        h = sha256_lanes(sbitvec.from_vec(v), 1)
        values[batch[0]['dst']] = sbitvec.from_vec(list(reversed(h.v)))
    else:
        v = combine([values[op['src']] for op in batch], n)
        v[k] = ~v[k]
        h = sha256_lanes(sbitvec.from_vec(v), n)
        for j, op in enumerate(batch):
            bits = [h.v[i].bit_decompose()[j] for i in range(256)]
            values[op['dst']] = sbitvec.from_vec(list(reversed(bits)))
stop_timer(1)

# 3. Outputs, in plan order. The driver parses revealed registers in the
# same order they are printed here.
export_shares = []
for out in plan.get('outputs', []):
    val = values[out['id']]
    if out['kind'] == 'mask':
        acc = val
        for player in range(N_PARTIES):
            acc = xor_vec(acc, t256.get_input_from(player))
        acc.reveal().print_reg()
    elif out['kind'] == 'open':
        val.reveal().print_reg()
    elif out['kind'] == 'export':
        bits = lsb_first(val)
        valid = less_than_const(bits, SECP256K1_ORDER) & nonzero(bits)
        s = sint.bit_compose(bits)
        export_shares.append(s)
        print_ln('valid %s', valid.reveal())
    else:
        raise Exception('unknown output kind')

if export_shares:
    # Calibration constant first, as point_export.py expects.
    sint.write_to_file([sint(1)] + export_shares, position=0)
