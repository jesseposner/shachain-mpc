# Generic shachain engine step, driven by a JSON plan file.
#
# The driver (poc/driver.py) does all public bookkeeping: which frontier
# nodes exist, which edges the next leaf needs, what leaves the run should
# reveal or export. This program executes one step:
#
#   1. Reconstruct secret values named in the plan, either from RSS seed
#      summands (XOR of per-slot inputs) or from masked frontier tuples
#      (public masked value XOR each active party's mask input).
#   2. Apply the planned flip-and-hash edges (BOLT #3 H_b).
#   3. Emit outputs: "mask" re-shares a value under fresh party masks and
#      reveals only the masked form; "open" reveals a leaf secret in the
#      clear (revocation); "export" converts a leaf to Z_q shares, checks
#      1 <= s < q, writes each party's share to persistence for point
#      export, and reveals the validity bit.
#
# The plan file path comes from the ENGINE_PLAN environment variable at
# compile time; a nonce argument keeps compiled program names distinct.
#
# Input order per party (the driver must write input files in this order):
#   1. its seed summands, in plan order (parties named by slot);
#   2. one mask per "masked" entry, in plan order (every party);
#   3. one fresh mask per "mask" output, in plan order (every party).
import json
import os

from circuit import sha256
from Compiler.GC.types import sbitvec, sbit, sbits

NONCE = program.args[1] if len(program.args) > 1 else '0'
N_PARTIES = 3
SECP256K1_ORDER = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141

plan = json.load(open(os.environ['ENGINE_PLAN']))
t256 = sbitvec.get_type(256)
values = {}


def bolt_flip_index(b):
    return (b // 8) * 8 + (7 - b % 8)


def xor_vec(a, b):
    return sbitvec.from_vec([x ^ y for x, y in zip(a.v, b.v)])


def lsb_first(x):
    return list(reversed(x.v))


def less_than_const(bits_lsb, c):
    lt = None
    for i, xi in enumerate(bits_lsb):
        if (c >> i) & 1:
            lt = ~xi if lt is None else ~(xi & ~lt)
        else:
            lt = None if lt is None else ~xi & lt
    return lt


def nonzero(bits):
    while len(bits) > 1:
        nxt = [~(~a & ~b) for a, b in zip(bits[0::2], bits[1::2])]
        if len(bits) % 2:
            nxt.append(bits[-1])
        bits = nxt
    return bits[0]


# 1. Reconstruct inputs.
for item in plan.get('summands', []):
    # {"id": ..., "slots": [players contributing one summand each]}
    acc = None
    for slot in item['slots']:
        contrib = t256.get_input_from(slot)
        acc = contrib if acc is None else xor_vec(acc, contrib)
    values[item['id']] = acc

for item in plan.get('masked', []):
    # {"id": ..., "m": hex of public masked value}
    acc = t256(int(item['m'], 16))
    for player in range(N_PARTIES):
        acc = xor_vec(acc, t256.get_input_from(player))
    values[item['id']] = acc

# 2. Hash edges.
start_timer(1)
for op in plan.get('ops', []):
    src = values[op['src']]
    v = list(src.v)
    k = bolt_flip_index(op['bit'])
    v[k] = ~v[k]
    h = sha256(sbitvec.from_vec(v))
    values[op['dst']] = sbitvec.from_vec(list(reversed(h.v)))
stop_timer(1)

# 3. Outputs, in plan order. The driver parses revealed registers in the
# same order they are printed here.
export_shares = []
for out in plan.get('outputs', []):
    val = values[out['id']]
    if out['kind'] == 'mask':
        acc = val
        for player in range(N_PARTIES):
            acc = xor_vec(acc, t256.get_input_from(player))
        acc.reveal().print_reg()
    elif out['kind'] == 'open':
        val.reveal().print_reg()
    elif out['kind'] == 'export':
        bits = lsb_first(val)
        valid = less_than_const(bits, SECP256K1_ORDER) & nonzero(bits)
        s = sint.bit_compose(bits)
        export_shares.append(s)
        print_ln('valid %s', valid.reveal())
    else:
        raise Exception('unknown output kind')

if export_shares:
    # Calibration constant first, as point_export.py expects.
    sint.write_to_file([sint(1)] + export_shares, position=0)
